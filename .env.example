# Vorlage. Kopieren nach .env und ausfuellen; .env wird nicht eingecheckt.
#
# Achtung: dieses Verzeichnis liegt unter OneDrive. Sieht ein Wert zur Laufzeit falsch aus,
# zuerst den Zeitstempel der .env ansehen, nicht den Lesecode.

# Wo Datenbank und Dateien liegen. Im Container setzt das Dockerfile DATA_DIR=/data.
DATA_DIR=./data

PORT=3220
LOG_LEVEL=info

# Mindestens 32 Zeichen, sonst bricht der Start ab. Erzeugen zum Beispiel mit
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

SESSION_TTL_HOURS=12
MAX_UPLOAD_MB=50

# Der erste Admin. Greift nur, solange ueberhaupt kein Admin existiert.
# Beide zusammen oder keiner, sonst bricht der Start ab.
ADMIN_EMAIL=
ADMIN_PASSWORT=

# Zugang fuer Axon zur Konnektor-API (Auftrag 2). Beide zusammen oder keiner.
CONNECTOR_BASIC_USER=
CONNECTOR_BASIC_PASSWORT=

# Die oeffentliche Adresse des **Dienstes**, nicht der Vite-Port. Lokal also der Server.
PUBLIC_BASE_URL=http://localhost:3220

VIEWER_BASE_URL=https://viewer-namur2026.aas.neoception.dev/

# Angezeigter Name, entschieden am 07.10.2026. Er steht einmal in der Kopfzeile, gruen und
# gesperrt. Der separate Veranstaltungszusatz aus dem Entwurf entfaellt, er sagte dasselbe.
# "Event Manager" ist bei Neoception ein anderes Produkt und darf hier nicht auftauchen.
APP_NAME=NAMUR HV 2026
