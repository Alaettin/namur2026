{
  "openapi": "3.0.1",
  "info": {
    "title": "Connector 1.0.0",
    "version": "1.0.0",
    "description": "This Open API specification describes connectors used by the Neoception DTI. A connector reads data from customer systems and exposes it in the normalized format required for on-demand Asset Administration Shell (AAS) generation.\n## General notes\nThe `itemId` identifies the entity for which data is requested. It should uniquely identify a single entity, stay within 1 to 2048 characters, use XML Schema 1.0 compatible characters and be URL-encodable.\nThe `Result` schema used for error bodies is optional, but providing meaningful messages and codes is recommended for diagnostics and traceability.\n## Authentication\nAuthentication from the connector to customer systems is connector-specific and should be abstracted away from the DTI. \nCurrently, the following authentication approaches are supported for DTI to connector communications:\n- OAuth2 via client credentials \n- Basic authentication\n"
  },
  "paths": {
    "/health": {
      "get": {
        "description": "Checks whether the connector is operational and currently able to reach the required customer systems. Anonymous access is recommended. Return `200 OK` when healthy and a `5XX` status when the connector or an upstream dependency is unavailable.",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "Ok"
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          }
        }
      }
    },
    "/versions": {
      "get": {
        "description": "Returns the supported connector specification version and, optionally, the deployed connector application version. Both values should follow Semantic Versioning 2.0.0.",
