    "/product/{itemId}/values": {
      "post": {
        "description": "Returns the requested scalar and document values for a single `itemId`. The caller sends a selected subset of property IDs and, for language-dependent content, an ordered list of preferred languages. \n\nFor returned documents, `value` may either be a ticket used on the `/product/{itemId}/documents` endpoint, the URL to the location the data may be accessed, or the Base64 encoded string of the contents of the file. If the file is an image, `value` must be the Base64 encoded string of the image. ",
        "tags": [
          "Product"
        ],
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "description": "Customer-defined identifier of the requested entity. It must uniquely identify a single entity, be URL-encodable and remain within 1 to 2048 characters.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Requested property IDs split into language-dependent and language-independent groups. When `languages` is `null` or empty, the connector should return all available language variants.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PropertyValuesRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PropertyValuesRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PropertyValuesRequest"
              }
            }
